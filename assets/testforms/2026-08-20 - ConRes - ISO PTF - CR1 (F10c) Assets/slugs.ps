/Slugs [
    %| {{Slugs}}
] def

(barcode.ps) run

% Helvetica re-encoded ISOLatin1Encoding for the slug display strings: the
% generator interpolates every value as Latin-1 bytes, and only that
% encoding places each byte on its Latin-1 glyph (\267 periodcentered,
% \327 multiply, \271 onesuperior, \263 threesuperior and the rest), so the
% slug's text extracts as the characters that were typed. StandardEncoding
% had \271 as quotedblbase, so a onesuperior read back as a quotedblbase.
/Helvetica-ISOLatin1
    /Helvetica findfont dup length dict begin
        { 1 index /FID ne { def } { pop pop } ifelse } forall
        /Encoding ISOLatin1Encoding def
        currentdict
    end
definefont pop

/merge_str {
    % combine multiple strings: [(a) (b) ... (z)] --> (ab...z)
    0 1 index { length add } forall string 0 3 2 roll
 	{ 3 copy putinterval length add } forall pop 
} bind def

/printIdAndDict {
    /currentDictId exch def
    /currentDict exch def

    currentDictId print (\n) print

    /maxKeyLength 0 def

    currentDict {
        /value exch def
        /key exch def
        /keyLength key length def

        maxKeyLength keyLength lt { /maxKeyLength keyLength def } if
    } forall
    
    currentDict {
        /value exch def
        /key exch def
        /keyLength key length def
        /keyPadding maxKeyLength keyLength sub 1 add string def

        0 1 keyPadding length 1 sub { keyPadding exch ( ) putinterval } for
        (  ) print key ==only keyPadding print value ===
    } forall

    currentDict
} bind def

/SlugPageWidth 792 def
/SlugPageHeight 595 def
/SlugPageMargin 72 4 div def

%| /SlugPageWidth {{SlugPageWidth}} def
%| /SlugPageHeight {{SlugPageHeight}} def
%| /SlugPageMargin {{SlugPageMargin}} def

%| {{SlugPage}}

% /SlugPadding SlugPageMargin 4 div def
% /SlugWidth   SlugPageWidth SlugPageMargin 2 mul sub 2 div def
% /SlugHeight  72 SlugPageMargin sub SlugPadding sub def
% /SlugXOffset SlugPageMargin def
% /SlugYOffset SlugPageHeight SlugPageMargin sub SlugHeight sub def

/SlugPadding 72 16 div def
/SlugWidth   356 def
/SlugHeight  54.5 def
/SlugXOffset 33.5 def
/SlugYOffset SlugPageHeight 33.5 sub SlugHeight sub def

%| /SlugPadding {{SlugPadding}} def
%| /SlugWidth {{SlugWidth}} def
%| /SlugHeight {{SlugHeight}} def
%| /SlugXOffset {{SlugXOffset}} def
%| /SlugYOffset {{SlugYOffset}} def

/SlugHeader (Slug CR YYYYMMDD) def
%| /SlugHeader ({{SlugHeader}}) def

/SlugFooter (YYYYMMDD HHMMSS) def
%| /SlugFooter ({{SlugFooter}}) def

%| {{Slug}}

<< /PageSize [ SlugPageWidth SlugPageHeight ] >> setpagedevice

Slugs {

    /Slug exch def

    /SlugTitle [
        % (Title: )
        Slug /Title get
        
        Slug /Variant known {
            ( \() 
            Slug /Variant get
            (\))
        } if
    ] merge_str def

    /SlugParameters [
        Slug /Parameters get
    ] merge_str def

    /SlugOutputParameters Slug /OutputParameters known {
        [Slug /OutputParameters get] merge_str
    } {
        ()
    } ifelse def

    % /QRCodeSize 72 def
    % The QR content path (2026-08-13): when the slug dict carries
    % /QRContents (the ECI 000026 + UTF-8 payload composed by the
    % generator; spec-compliant Unicode per ISO/IEC 18004, requiring
    % BWIPP's parsefnc) it IS the QR payload, decoupled from the Latin-1
    % display strings; otherwise the payload assembles from the display
    % strings as before.
    /QRCodeContents Slug /QRContents known {
        Slug /QRContents get
    } {
        [
            SlugHeader
            (\n)
            SlugTitle
            (\n)
            SlugParameters
            SlugOutputParameters length 0 gt {
                (\n)
                SlugOutputParameters
            } if
            (\n)
            SlugFooter
        ] merge_str
    } ifelse def

    /QRCodeECLevel (L) def

    /QRCodeMeasureOptions << /dontdraw true /eclevel QRCodeECLevel >> def
    /QRCodeDrawOptions << /eclevel QRCodeECLevel >> def
    Slug /QRContents known {
        QRCodeMeasureOptions /parsefnc true put
        QRCodeDrawOptions /parsefnc true put
    } if

    /QRCodeDict QRCodeContents QRCodeMeasureOptions /qrcode /uk.co.terryburton.bwipp findresource exec def
    /QRCodeHeight QRCodeDict /height get 72 mul def
    /QRCodeWidth QRCodeDict /width get 72 mul def
    /QRCodeScale SlugHeight QRCodeHeight div def

    QRCodeDict (QRCodeDict) printIdAndDict pop

    SlugXOffset SlugYOffset moveto

    gsave

    /SlugRect {
        newpath
        SlugXOffset SlugPadding sub SlugYOffset SlugPadding sub moveto
        SlugXOffset SlugWidth add SlugPadding add SlugYOffset SlugPadding sub lineto
        SlugXOffset SlugWidth add SlugPadding add SlugYOffset SlugHeight add SlugPadding add lineto
        SlugXOffset SlugPadding sub SlugYOffset SlugHeight add SlugPadding add lineto
        closepath
    } bind def

    0 setlinewidth
    0.5 setgray SlugRect stroke
    0.95 setgray SlugRect fill
    0 setgray

    % /DeviceRGB setcolorspace 
    % 0 setlinewidth
    % 0.5 dup dup setcolor
    % SlugRect stroke
    % 0.95 dup dup setcolor
    % SlugRect fill
    % 0 dup dup setcolor

    grestore

    gsave

    QRCodeScale QRCodeScale scale
    
    QRCodeContents QRCodeDrawOptions /qrcode /uk.co.terryburton.bwipp findresource exec

    grestore
    
    QRCodeWidth QRCodeScale mul SlugPadding add QRCodeHeight QRCodeScale mul rmoveto

    0 -9 rmoveto
    gsave
    /Helvetica-ISOLatin1 findfont 9 scalefont setfont SlugTitle show
    grestore

    0 -9 rmoveto
    gsave
    /Helvetica-ISOLatin1 findfont 6 scalefont setfont SlugParameters show
    grestore

    SlugOutputParameters length 0 gt {
        0 -9 rmoveto
        gsave
        /Helvetica-ISOLatin1 findfont 6 scalefont setfont SlugOutputParameters show
        grestore
    } if

    0 -9 rmoveto
    gsave
    /Helvetica-ISOLatin1 findfont 6 scalefont setfont SlugFooter show
    grestore

    showpage

} forall
